# ---------------------------------------------------------------------------
# Simple retrieval over corpora
# ---------------------------------------------------------------------------


def _score_doc(query: str, text: str, tags: list[str]) -> float:
    q = tokens(query)
    if not q:
        return 0.0
    bag = Counter(tokens(text + " " + " ".join(tags)))
    tf = sum(bag.get(t, 0) for t in q)
    cover = coverage(query, text)
    tag_hit = sum(1 for t in q if t in {x.lower() for x in tags})
    return 0.45 * cover + 0.35 * min(1.0, tf / max(3, len(q))) + 0.2 * min(1.0, tag_hit / max(1, len(q)))


def search_web(query: str, k: int = 4) -> list[dict]:
    ranked = []
    for doc in WEB_CORPUS:
        s = _score_doc(query, doc["body"] + " " + doc["title"], doc["tags"])
        if s > 0.05:
            ranked.append(
                {
                    "id": doc["id"],
                    "title": doc["title"],
                    "url": doc["url"],
                    "domain": doc["domain"],
                    "year": doc["year"],
                    "snippet": doc["snippet"],
                    "score": round(s, 4),
                }
            )
    ranked.sort(key=lambda x: x["score"], reverse=True)
    return ranked[:k]


def fetch_source(source_id: str) -> dict:
    for doc in WEB_CORPUS:
        if doc["id"] == source_id or doc["url"] == source_id:
            return {
                "id": doc["id"],
                "title": doc["title"],
                "url": doc["url"],
                "year": doc["year"],
                "body": doc["body"],
            }
    return {"error": f"Unknown source: {source_id}"}


def knowledge_lookup(query: str, k: int = 3) -> list[dict]:
    ranked = []
    for doc in KB_CORPUS:
        s = _score_doc(query, doc["text"] + " " + doc["title"], doc["tags"])
        if s > 0.04:
            ranked.append(
                {
                    "id": doc["id"],
                    "title": doc["title"],
                    "source": doc["source"],
                    "excerpt": doc["text"][:320],
                    "score": round(s, 4),
                }
            )
    ranked.sort(key=lambda x: x["score"], reverse=True)
    return ranked[:k]


# ---------------------------------------------------------------------------
# Tool registry (schemas + handlers)
# ---------------------------------------------------------------------------


@dataclass
class ToolSpec:
    name: str
    description: str
    parameters: dict
    handler: Callable[[dict], Any]


class ToolBelt:
    """Runtime tool registry — the agent discovers tools from schemas, not a fixed script."""

    def __init__(self):
        self._notes: dict[str, list[str]] = defaultdict(list)
        self.tools: dict[str, ToolSpec] = {}
        self._register_defaults()

    def _register_defaults(self):
        self.register(
            ToolSpec(
                name="web_search",
                description="Search the open web index for pages relevant to a query. Returns titles, URLs, snippets.",
                parameters={
                    "type": "object",
                    "properties": {
                        "query": {"type": "string", "description": "Search query"},
                        "k": {"type": "integer", "description": "Max results", "default": 4},
                    },
                    "required": ["query"],
                },
                handler=lambda args: search_web(args["query"], int(args.get("k", 4))),
            )
        )
        self.register(
            ToolSpec(
                name="fetch_source",
                description="Fetch the full body of a web source by id or URL from a prior search result.",
                parameters={
                    "type": "object",
                    "properties": {
                        "source_id": {"type": "string", "description": "Source id or URL"},
                    },
                    "required": ["source_id"],
                },
                handler=lambda args: fetch_source(args["source_id"]),
            )
        )
        self.register(
            ToolSpec(
                name="knowledge_lookup",
                description="Search the internal knowledge base for methods, policies, and report templates.",
                parameters={
                    "type": "object",
                    "properties": {
                        "query": {"type": "string"},
                        "k": {"type": "integer", "default": 3},
                    },
                    "required": ["query"],
                },
                handler=lambda args: knowledge_lookup(args["query"], int(args.get("k", 3))),
            )
        )
        self.register(
            ToolSpec(
                name="note_taking",
                description=(
                    "Write or read working notes for the current session so multi-step research "
                    "keeps intermediate findings without hardcoding order."
                ),
                parameters={
                    "type": "object",
                    "properties": {
                        "action": {"type": "string", "enum": ["write", "read"]},
                        "session_id": {"type": "string"},
                        "note": {"type": "string", "description": "Required when action=write"},
                    },
                    "required": ["action", "session_id"],
                },
                handler=self._notes_handler,
            )
        )

    def _notes_handler(self, args: dict) -> dict:
        sid = args["session_id"]
        if args["action"] == "write":
            note = (args.get("note") or "").strip()
            if not note:
                return {"error": "note required for write"}
            self._notes[sid].append(note)
            self._notes[sid] = self._notes[sid][-20:]
            return {"ok": True, "count": len(self._notes[sid])}
        return {"notes": list(self._notes.get(sid, []))}

    def register(self, spec: ToolSpec):
        self.tools[spec.name] = spec

    def schemas(self) -> list[dict]:
        return [
            {
                "name": t.name,
                "description": t.description,
                "parameters": t.parameters,
            }
            for t in self.tools.values()
        ]

    def call(self, name: str, arguments: dict) -> Any:
        if name not in self.tools:
            return {"error": f"Unknown tool: {name}"}
        try:
            return self.tools[name].handler(arguments or {})
        except Exception as err:  # noqa: BLE001
            return {"error": str(err)}


# ---------------------------------------------------------------------------
# Session memory
