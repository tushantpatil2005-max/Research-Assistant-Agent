def tokens(text: str, drop_stop: bool = True) -> list[str]:
    parts = re.sub(r"[^a-z0-9]+", " ", text.lower()).split()
    parts = [t for t in parts if len(t) > 1]
    if drop_stop:
        parts = [t for t in parts if t not in STOP]
    return parts


def estimate_tokens(text: str) -> int:
    return max(1, math.ceil(len(text) / 4))


def fnv(s: str) -> int:
    h = 2166136261
    for ch in s:
        h ^= ord(ch)
        h = (h * 16777619) & 0xFFFFFFFF
    return h


def embed(text: str) -> list[float]:
    v = [0.0] * EMBED_DIM
    for t in tokens(text, drop_stop=False):
        h = fnv(t)
        i = h % EMBED_DIM
        v[i] += 1.0 if (h & 0x100) else -1.0
    n = math.sqrt(sum(x * x for x in v)) or 1.0
    return [x / n for x in v]


def cosine(a: list[float], b: list[float]) -> float:
    return sum(x * y for x, y in zip(a, b))


def coverage(query: str, text: str) -> float:
    q = tokens(query)
    if not q:
        return 0.0
    hay = f" {text.lower()} "
    return sum(1 for t in q if f" {t}" in hay or t in hay) / len(q)


def strip_machine_labels(text: str) -> str:
    cleaned = re.sub(
        r"(?i)\s*[\(\[]?\s*(ai[- ]generated|generated by (ai|an? (ai|llm|model))|"
        r"as an ai[\w\s]*|powered by ai|created with (ai|chatgpt))\s*[\)\]]?\s*",
        " ",
        text,
    )
    return re.sub(r"\s{2,}", " ", cleaned).strip()


def is_ambiguous(question: str) -> bool:
    q = question.strip()
    if len(q) < 12:
        return True
    vague = bool(
        re.search(
            r"^(tell me about|what about|research|look into|find out|info on)\s*$",
            q,
            re.I,
        )
    )
    missing_object = bool(
        re.match(r"^(tell me about|research|look into|find out about|info on)\s*$", q, re.I)
    )
    pronouns_only = bool(re.match(r"^(it|this|that|they)\b", q, re.I)) and len(tokens(q)) < 4
    bare = len(tokens(q)) < 3 and not re.search(r"\d{4}|vs|versus|compare|how|why|what", q, re.I)
    return vague or missing_object or pronouns_only or bare


