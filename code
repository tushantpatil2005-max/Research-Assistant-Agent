            "ok": True,
            "tools": [t["name"] for t in _agent.tool_schemas()],
            "max_steps": _agent.max_steps,
        }

    @app.post("/research")
    async def research_endpoint(body: ResearchBody):
        return await _agent.research(
            body.question, session_id=body.session_id, remote_models=body.remote_models
        )

    @app.get("/tools")
    def list_tools():
        return _agent.tool_schemas()


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def main():
    parser = argparse.ArgumentParser(description="AI Research Assistant Agent")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("-q", "--question", type=str)
    parser.add_argument("--session", default="cli")
    parser.add_argument("--remote", action="store_true")
    parser.add_argument("--serve", action="store_true")
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--port", type=int, default=8000)
    args = parser.parse_args()

    if args.check:
        notes = asyncio.run(self_check())
        print("PASS")
        for n in notes:
            print(n)
        return

    if args.serve:
        if not HAS_FASTAPI:
            raise SystemExit("Install fastapi uvicorn: pip install fastapi uvicorn")
        import uvicorn

        uvicorn.run(app, host=args.host, port=args.port)
        return

    if not args.question:
        parser.print_help()
        return

    agent = ResearchAgent(remote_models=args.remote)
    result = asyncio.run(
        agent.research(args.question, session_id=args.session, remote_models=args.remote)
    )
    if result.get("markdown"):
        print(result["markdown"])
        print("\n---\n")
    print(json.dumps({k: v for k, v in result.items() if k != "markdown"}, indent=2, default=str))


if __name__ == "__main__":
    main()
