class SessionMemory:
    def __init__(self):
        self._turns: dict[str, list[dict]] = defaultdict(list)

    def history(self, session_id: str) -> list[dict]:
        return list(self._turns.get(session_id, []))

    def add(self, session_id: str, role: str, content: str, meta: Optional[dict] = None):
        self._turns[session_id].append(
            {"role": role, "content": content, "meta": meta or {}}
        )
        self._turns[session_id] = self._turns[session_id][-24:]

    def last_report(self, session_id: str) -> Optional[dict]:
        for turn in reversed(self._turns.get(session_id, [])):
            if turn["role"] == "report" and turn.get("meta"):
                return turn["meta"]
        return None


# ---------------------------------------------------------------------------
# Optional Llama for free-form thoughts (fallback: deterministic planner)
# ---------------------------------------------------------------------------


def llama_complete(
    base_url: str,
    model: str,
    messages: list[dict],
    max_tokens: int = 400,
    timeout: float = 2.0,
    api_key: Optional[str] = None,
) -> dict:
    url = base_url.rstrip("/") + "/v1/chat/completions"
    body = json.dumps(
        {
            "model": model,
            "temperature": 0.2,
            "max_tokens": max_tokens,
            "messages": messages,
        }
    ).encode()
    headers = {"Content-Type": "application/json"}
    if api_key:
        headers["Authorization"] = f"Bearer {api_key}"
    req = Request(url, data=body, headers=headers, method="POST")
    with urlopen(req, timeout=timeout) as resp:
        data = json.loads(resp.read().decode())
    choice = (data.get("choices") or [{}])[0]
    msg = choice.get("message") or {}
    usage = data.get("usage") or {}
    return {
        "content": msg.get("content") or "",
        "tokens_in": usage.get("prompt_tokens", estimate_tokens("\n".join(m["content"] for m in messages))),
        "tokens_out": usage.get("completion_tokens", estimate_tokens(msg.get("content") or "")),
        "model": model,
    }


# ---------------------------------------------------------------------------
# Iterative planner — chooses tools dynamically (not a hardcoded pipeline)
# ---------------------------------------------------------------------------


@dataclass
class StepRecord:
    step: int
    thought: str
    action: str
    arguments: dict
    observation: Any
    latency_ms: float


def deterministic_plan(
    question: str,
    step: int,
    observations: list[StepRecord],
    session_id: str,
    ambiguous: bool,
) -> tuple[str, str, dict]:
    """
    Lightweight policy that still *selects* tools from state, not a fixed sequence.
    Branching depends on prior observations so the path is data-driven.
    """
    used = {s.action for s in observations}
    has_web = any(s.action == "web_search" and not _obs_error(s.observation) for s in observations)
    has_fetch = any(s.action == "fetch_source" and not _obs_error(s.observation) for s in observations)
    has_kb = any(s.action == "knowledge_lookup" and not _obs_error(s.observation) for s in observations)
    notes_written = any(s.action == "note_taking" and s.arguments.get("action") == "write" for s in observations)

    if ambiguous and step == 0:
        return (
            "The request is underspecified; ask for a concrete topic before spending search budget.",
            "finish",
            {
                "status": "need_clarification",
                "clarifying_question": (
                    "What topic, comparison, or time period should the research cover?"
                ),
            },
        )

    if not has_web:
        return (
            "No web evidence yet. Search the open index for pages related to the question.",
            "web_search",
            {"query": question, "k": 4},
        )

    # Pick best unfetched web hit
    web_hits: list[dict] = []
    for s in observations:
        if s.action == "web_search" and isinstance(s.observation, list):
            web_hits.extend(s.observation)
    fetched_ids = {
        s.arguments.get("source_id")
        for s in observations
        if s.action == "fetch_source"
    }
    for hit in sorted(web_hits, key=lambda h: h.get("score", 0), reverse=True):
        if hit["id"] not in fetched_ids:
            return (
                f"Fetch full text for top result {hit['id']} to support cited claims.",
                "fetch_source",
                {"source_id": hit["id"]},
            )

    if not has_kb:
        return (
            "Consult internal notes on report structure and method so the output stays consistent.",
            "knowledge_lookup",
            {"query": "research report schema citations clarify", "k": 3},
        )

    if not notes_written and has_fetch:
        bullets = []
        for s in observations:
            if s.action == "fetch_source" and isinstance(s.observation, dict) and "body" in s.observation:
                body = s.observation["body"]
                first = re.split(r"(?<=\.)\s+", body)[0]
                bullets.append(f"{s.observation['id']}: {first}")
        note = " | ".join(bullets[:3]) or f"Working notes for: {question}"
        return (
            "Persist intermediate findings in session notes before drafting the report.",
            "note_taking",
            {"action": "write", "session_id": session_id, "note": note},
        )

    # Enough evidence — finish
    return (
        "Evidence collected from web and knowledge sources; produce the structured report.",
        "finish",
        {"status": "complete"},
    )


def _obs_error(obs: Any) -> bool:
    return isinstance(obs, dict) and "error" in obs


def parse_llm_action(text: str) -> Optional[tuple[str, str, dict]]:
    """Parse Thought/Action/Action Input blocks if a remote model is used."""
    thought_m = re.search(r"Thought:\s*(.+?)(?:\nAction:|$)", text, re.S | re.I)
    action_m = re.search(r"Action:\s*([a-zA-Z_]+)", text, re.I)
    args_m = re.search(r"Action Input:\s*(\{.*?\})", text, re.S | re.I)
    if not action_m:
        return None
    thought = (thought_m.group(1).strip() if thought_m else "Continue research.")[:400]
    action = action_m.group(1).strip()
    args: dict = {}
    if args_m:
        try:
            args = json.loads(args_m.group(1))
        except json.JSONDecodeError:
            args = {}
    return thought, action, args


# ---------------------------------------------------------------------------
# Report builder
# ---------------------------------------------------------------------------


def build_report(
    question: str,
    steps: list[StepRecord],
    session_id: str,
) -> dict:
    references: list[dict] = []
    ref_index: dict[str, int] = {}
    findings: list[dict] = []
    sources_seen: list[str] = []

    def add_ref(key: str, title: str, url: str, domain: str = "") -> int:
        if key in ref_index:
            return ref_index[key]
        n = len(references) + 1
        ref_index[key] = n
        references.append(
            {
                "id": n,
                "key": key,
                "title": title,
                "url": url,
                "domain": domain,
            }
        )
        return n

    for s in steps:
        if s.action == "fetch_source" and isinstance(s.observation, dict) and "body" in s.observation:
            obs = s.observation
            rid = add_ref(obs["id"], obs["title"], obs.get("url", ""), "")
            sources_seen.append(obs["id"])
            # Split into sentences as claim candidates
            for sent in re.split(r"(?<=\.)\s+", obs["body"]):
                sent = sent.strip()
                if len(sent) < 60:
                    continue
                findings.append(
                    {
                        "claim": strip_machine_labels(sent),
                        "citation_ids": [rid],
                        "source_id": obs["id"],
                    }
                )
        if s.action == "knowledge_lookup" and isinstance(s.observation, list):
            for item in s.observation:
                rid = add_ref(item["id"], item["title"], item.get("source", ""), "knowledge")
                excerpt = item.get("excerpt", "")
                if len(excerpt) > 40:
                    findings.append(
                        {
                            "claim": strip_machine_labels(excerpt.split(".")[0] + "."),
                            "citation_ids": [rid],
                            "source_id": item["id"],
                        }
                    )

    # Prefer findings whose tokens overlap the question
    findings.sort(key=lambda f: coverage(question, f["claim"]), reverse=True)
    findings = findings[:6]

    # Deduplicate near-identical claims
    unique: list[dict] = []
    seen_norm: set[str] = set()
    for f in findings:
        key = re.sub(r"\s+", " ", f["claim"].lower())[:80]
        if key in seen_norm:
            continue
        seen_norm.add(key)
        unique.append(f)
    findings = unique

    summary_bits = [f["claim"] for f in findings[:3]]
    if summary_bits:
        executive = strip_machine_labels(" ".join(summary_bits))
        if len(executive) > 480:
            executive = executive[:477] + "…"
    else:
        executive = (
            "Available sources did not yield enough overlapping evidence to summarize this topic."
        )

    open_questions = []
    if len(findings) < 2:
        open_questions.append("Additional primary sources may be needed for a fuller answer.")
    if not any("year" in str(s.observation) for s in steps):
        open_questions.append("Time scope of the evidence could be narrowed further.")

    title = strip_machine_labels(
        re.sub(r"\s+", " ", question).strip().rstrip("?")[:100]
        or "Research report"
    )

    report = {
        "title": title if title.lower().startswith("research") else f"Research report: {title}",
        "question": question,
        "executive_summary": executive,
        "key_findings": findings,
        "open_questions": open_questions,
        "references": references,
        "sources_consulted": sources_seen,
        "session_id": session_id,
    }
    return report


def render_report_markdown(report: dict) -> str:
    lines = [
        f"# {report['title']}",
        "",
        f"**Question.** {report['question']}",
        "",
        "## Executive summary",
        "",
        report["executive_summary"],
        "",
        "## Key findings",
        "",
    ]
    if not report["key_findings"]:
        lines.append("- No grounded findings available.")
    for f in report["key_findings"]:
        cites = ",".join(str(i) for i in f["citation_ids"])
        lines.append(f"- {f['claim']} [{cites}]")
    lines += ["", "## Open questions", ""]
    if report["open_questions"]:
        for q in report["open_questions"]:
            lines.append(f"- {q}")
    else:
        lines.append("- None recorded.")
    lines += ["", "## References", ""]
    if not report["references"]:
        lines.append("- None.")
    for r in report["references"]:
        loc = r.get("url") or r.get("domain") or ""
        lines.append(f"[{r['id']}] {r['title']} — {loc}")
    text = "\n".join(lines)
    return strip_machine_labels(text)


# ---------------------------------------------------------------------------
# Agent
# ---------------------------------------------------------------------------


class ResearchAgent:
    def __init__(
        self,
        remote_models: bool = False,
        llama_base: str = LLAMA_BASE,
        llama_models: Optional[list[str]] = None,
        api_key: Optional[str] = None,
        max_steps: int = MAX_STEPS,
    ):
        self.tools = ToolBelt()
        self.memory = SessionMemory()
        self.remote_models = remote_models
        self.llama_base = llama_base
        self.llama_models = llama_models or list(LLAMA_MODELS)
        self.api_key = api_key
        self.max_steps = max_steps
        self.runs: dict[str, dict] = {}

    def tool_schemas(self) -> list[dict]:
        return self.tools.schemas()

    async def research(
        self,
        question: str,
        session_id: str = "default",
        remote_models: Optional[bool] = None,
    ) -> dict:
        t0 = time.time()
        use_remote = self.remote_models if remote_models is None else remote_models
        q = question.strip()
        run_id = f"run_{uuid.uuid4().hex[:8]}"
        steps: list[StepRecord] = []
        model_route: list[str] = []
        failures: list[dict] = []
        tokens_in = 0
        tokens_out = 0

        self.memory.add(session_id, "user", q)

        # Follow-up: if question refers to prior work, fold context in
        prior = self.memory.last_report(session_id)
        effective_q = q
        if prior and re.search(r"\b(that|this|previous|earlier|it)\b", q, re.I) and len(tokens(q)) < 8:
            effective_q = f"{q} (context: {prior.get('question', '')})"

        ambiguous = is_ambiguous(q) and not prior

        for i in range(self.max_steps):
            if (time.time() - t0) * 1000 > SLA_MS:
                failures.append({"step": i, "message": "SLA budget exhausted", "recovered": False})
                break

            thought, action, arguments = await self._choose_action(
                effective_q,
                i,
                steps,
                session_id,
                ambiguous,
                use_remote,
                model_route,
                failures,
            )

            # Token estimate for planner text
            tokens_in += estimate_tokens(thought + action + json.dumps(arguments))

            if action == "finish":
                steps.append(
                    StepRecord(i, thought, action, arguments, arguments, 0.0)
                )
                break

            t_tool = time.time()
            # Inject session_id for note_taking if omitted
            if action == "note_taking" and "session_id" not in arguments:
                arguments = {**arguments, "session_id": session_id}
            observation = self.tools.call(action, arguments)
            latency = (time.time() - t_tool) * 1000
            steps.append(StepRecord(i, thought, action, arguments, observation, latency))
            tokens_out += estimate_tokens(json.dumps(observation)[:2000])

            # After clarification finish path handled below
        else:
            # max steps without finish
            steps.append(
                StepRecord(
                    len(steps),
                    "Step budget reached; drafting with evidence on hand.",
                    "finish",
                    {"status": "complete"},
                    {"status": "complete"},
                    0.0,
                )
            )

        last = steps[-1] if steps else None
        if last and last.action == "finish" and last.arguments.get("status") == "need_clarification":
            result = {
                "id": run_id,
                "status": "need_clarification",
                "question": q,
                "clarifying_question": last.arguments.get(
                    "clarifying_question",
                    "Please provide a more specific research topic.",
                ),
                "report": None,
                "markdown": None,
                "steps": [_step_dict(s) for s in steps],
                "tools_used": sorted({s.action for s in steps if s.action != "finish"}),
                "model_route": model_route or ["deterministic-planner"],
                "timings": {
                    "total_ms": round((time.time() - t0) * 1000, 2),
                    "sla_ms": SLA_MS,
                },
                "failures": failures,
                "token_estimate": {"input": tokens_in, "output": tokens_out},
                "session_id": session_id,
            }
            self.memory.add(session_id, "assistant", result["clarifying_question"], {"status": "need_clarification"})
            self.runs[run_id] = result
            return result

        report = build_report(effective_q, steps, session_id)
        markdown = render_report_markdown(report)
        self.memory.add(session_id, "report", report["executive_summary"], report)

        tools_used = sorted({s.action for s in steps if s.action != "finish"})
        result = {
            "id": run_id,
            "status": "complete",
            "question": q,
            "report": report,
            "markdown": markdown,
            "steps": [_step_dict(s) for s in steps],
            "tools_used": tools_used,
            "model_route": model_route or ["deterministic-planner"],
            "timings": {
                "total_ms": round((time.time() - t0) * 1000, 2),
                "sla_ms": SLA_MS,
            },
            "failures": failures,
            "token_estimate": {"input": tokens_in, "output": tokens_out},
            "session_id": session_id,
        }
        self.runs[run_id] = result
        return result

    async def _choose_action(
        self,
        question: str,
        step: int,
        history: list[StepRecord],
        session_id: str,
        ambiguous: bool,
        use_remote: bool,
        model_route: list[str],
        failures: list[dict],
    ) -> tuple[str, str, dict]:
        # Always have a deterministic plan available
        det = deterministic_plan(question, step, history, session_id, ambiguous)

        if not use_remote:
            model_route.append("deterministic-planner")
            return det

        # Try Llama to propose next action; fall back on failure
        tool_desc = json.dumps(self.tools.schemas(), indent=2)
        hist_txt = "\n".join(
            f"Step {s.step}: Thought: {s.thought}\nAction: {s.action}\n"
            f"Action Input: {json.dumps(s.arguments)}\nObservation: {json.dumps(s.observation)[:500]}"
            for s in history[-4:]
        )
        prompt = (
            "You are a research agent. Use this exact format:\n"
            "Thought: ...\nAction: <tool_name|finish>\nAction Input: <json>\n\n"
            f"Available tools:\n{tool_desc}\n\n"
            f"Question: {question}\nSession: {session_id}\n"
            f"History:\n{hist_txt or '(none)'}\n\n"
            "Choose the next tool or finish. Do not invent tool names."
        )
        for model in self.llama_models:
            try:
                resp = await asyncio.get_event_loop().run_in_executor(
                    None,
                    lambda m=model: llama_complete(
                        self.llama_base,
                        m,
                        [
                            {
                                "role": "system",
                                "content": (
                                    "You plan tool calls for research. Reply only with Thought, "
                                    "Action, and Action Input. Never add origin labels to answers."
                                ),
                            },
                            {"role": "user", "content": prompt},
                        ],
                        max_tokens=300,
                        timeout=2.0,
                        api_key=self.api_key,
                    ),
                )
                parsed = parse_llm_action(resp["content"])
                if parsed and (parsed[1] in self.tools.tools or parsed[1] == "finish"):
                    model_route.append(model)
                    return parsed
                failures.append(
                    {
                        "step": step,
                        "message": f"{model} produced unusable action",
                        "recovered": True,
                    }
                )
            except Exception as err:  # noqa: BLE001
                failures.append({"step": step, "message": str(err), "recovered": True})
        model_route.append("deterministic-planner")
        return det


def _step_dict(s: StepRecord) -> dict:
    return {
        "step": s.step,
        "thought": s.thought,
        "action": s.action,
        "arguments": s.arguments,
        "observation": s.observation,
        "latency_ms": round(s.latency_ms, 2),
    }


# ---------------------------------------------------------------------------
# Self-check
# ---------------------------------------------------------------------------


async def self_check() -> list[str]:
    notes: list[str] = []
    agent = ResearchAgent(remote_models=False)

    schemas = agent.tool_schemas()
    assert len(schemas) >= 3, f"need >=3 tools, got {len(schemas)}"
    names = {t["name"] for t in schemas}
    for required in ("web_search", "fetch_source", "knowledge_lookup"):
        assert required in names

    # Ambiguous request
    amb = await agent.research("tell me about", session_id="amb")
    assert amb["status"] == "need_clarification", amb
    notes.append(f"ambiguous -> {amb['clarifying_question']}")

    # Full research run
    result = await agent.research(
        "How do tool-using research agents combine retrieval, citations, and iterative reasoning?",
        session_id="main",
    )
    assert result["status"] == "complete", result.get("status")
    assert len(result["tools_used"]) >= 3, result["tools_used"]
    assert result["report"] and result["report"]["references"], "missing citations"
    assert result["report"]["key_findings"], "missing findings"
    assert result["markdown"] and result["markdown"].startswith("#")
    # No AI marking
    blob = json.dumps(result["report"]) + result["markdown"]
    assert not re.search(r"(?i)ai[- ]generated|powered by ai|as an ai", blob)
    notes.append(f"tools={result['tools_used']} findings={len(result['report']['key_findings'])}")
    notes.append(f"ms={result['timings']['total_ms']}")

    # Context across steps / follow-up
    follow = await agent.research(
        "What did the previous report conclude?",
        session_id="main",
    )
    assert follow["status"] == "complete"
    notes.append(f"follow-up status={follow['status']} refs={len(follow['report']['references'])}")

    # Iterative: steps show different actions, not a single hardcoded call
    actions = [s["action"] for s in result["steps"]]
    assert actions.count("web_search") >= 1
    assert "fetch_source" in actions
    assert "finish" in actions
    # Order is state-dependent (fetch only after search)
    assert actions.index("web_search") < actions.index("fetch_source")

    return notes


